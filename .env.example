# Copy to .env (git-ignored) and fill in. Generate real values with:
#   python -m solution gen-keys
# Two DIFFERENT keys are required (key separation).
LEDGER_ENCRYPTION_KEY=<base64url of 32 random bytes - AES-256-GCM, reversible PII>
LEDGER_HMAC_KEY=<base64url of >=32 random bytes - HMAC-SHA256, deterministic phone matching>

# Optional
# LEDGER_DB=ledger.db
# LEDGER_SCHEMAS_DIR=assignment-a-data/schemas
